# Ambiente virtual
.venv/

# Arquivos temporários do Python
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
build/
dist/

# Configurações e segredos locais
.env
.env.*
!.env.example

# Entradas e resultados locais
input/*.xlsx
input/*.xlsm
output/*
backup/*
logs/*

# Mantém as pastas vazias no projeto
!input/.gitkeep
!output/.gitkeep
!backup/.gitkeep
!logs/.gitkeep

# Arquivos temporários do Excel
~$*.xlsx
~$*.xlsm

# Sistema e editor
.DS_Store
Thumbs.db
